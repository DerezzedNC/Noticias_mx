# 📄 Archivo de ejemplo para variables de entorno
# Copia este archivo como .env y configura los valores apropiados

# Puerto del servidor
PORT=3000

# URI de conexión a MongoDB
MONGODB_URI=mongodb://localhost:27017/noticias_express

# Clave secreta para JWT (¡CAMBIA ESTO EN PRODUCCIÓN!)
JWT_SECRET=tu_clave_secreta_jwt_muy_segura_aqui_2024

# Tiempo de expiración del token JWT
JWT_EXPIRES_IN=7d

# Entorno de ejecución
NODE_ENV=development